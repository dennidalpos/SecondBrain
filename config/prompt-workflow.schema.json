{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "key", "title", "revision", "status", "steps"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^wfl-[0-9a-f]{8}$"},
    "key": {"type": "string", "pattern": "^wf-[a-z0-9]+(-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 88, "pattern": "^[^\\r\\n\\t]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["active", "deprecated", "retired"]},
    "pack": {"enum": ["core", "site", "llm"]},
    "steps": {"type": "array", "minItems": 1, "maxItems": 20, "items": {
      "type": "object", "additionalProperties": false, "required": ["step", "ref", "kind", "gate"],
      "properties": {
        "step": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "ref": {"type": "string", "pattern": "^pmt-[0-9a-f]{8}$"},
        "kind": {"enum": ["required", "optional", "choice"]},
        "gate": {"enum": ["auto", "confirm"]},
        "choices": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^pmt-[0-9a-f]{8}$"}}
      }
    }}
  }
}
