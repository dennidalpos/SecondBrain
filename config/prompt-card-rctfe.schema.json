{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCTFE prompt card (Role, Context, Task, Format and constraints, optional Examples)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "code", "kind", "description", "role", "context", "task", "format"],
  "properties": {
    "schemaVersion": {"const": 1},
    "code": {"type": "string", "pattern": "^[A-Z]{2,4}[0-9]{2}$"},
    "kind": {"enum": ["system", "user"]},
    "description": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\r\n\t]+$"},
    "role": {"type": "string", "minLength": 1},
    "context": {"type": "string", "minLength": 1},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "steps"],
      "properties": {
        "plan": {"type": "string", "minLength": 1, "pattern": "^[^\r\n\t]+$"},
        "steps": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}
      }
    },
    "format": {"type": "string", "minLength": 1},
    "examples": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "chain": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^pmt-[0-9a-f]{8}$"}}
  }
}
