{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dossier compaction candidate (one-shot analysis, dossier.compact)",
  "type": "object",
  "additionalProperties": false,
  "required": ["context", "memory", "notes"],
  "properties": {
    "context": { "type": "string", "minLength": 1, "maxLength": 60000 },
    "memory": { "type": "string", "minLength": 1, "maxLength": 60000 },
    "notes": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 300 } }
  }
}
