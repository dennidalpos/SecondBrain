{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User prompt draft (light model, #753): the RCTFE fields of a prompt card from a one-line goal; the person previews and saves",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "role", "context", "task", "format"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "role": { "type": "string", "minLength": 1, "maxLength": 600 },
    "context": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "task": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "format": { "type": "string", "minLength": 1, "maxLength": 600 }
  }
}
